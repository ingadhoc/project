<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_project_stock_quick" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.project.stock.quick</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="project_stock.view_picking_form_inherit_project_stock"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="task_id" groups="project.group_project_user"
                       domain="[('project_id', '=?', project_id), ('has_template_ancestor', '=', False)]"/>
            </field>
        </field>
    </record>

</odoo>
