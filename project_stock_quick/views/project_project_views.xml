<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project_inherit_project_stock_quick" model="ir.ui.view">
        <field name="name">project.project.form.inherit.project.stock.quick</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_time_managment']" position="before">
                <group name="group_stock_management" string="Inventory" col="1"
                       class="row mt16 o_settings_container" groups="stock.group_stock_user">
                    <div>
                        <field name="type_ids" invisible="1"/>
                        <setting class="col-lg-12" id="allow_stock_picking_setting"
                                 help="Enables, on the tasks, the button to create stock pickings">
                            <field name="allow_stock_picking"/>
                            <div class="content-group mt16" invisible="not allow_stock_picking">
                                <div class="row">
                                    <label for="picking_type_id" class="col-lg-5 o_light_label"/>
                                    <field name="picking_type_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="picking_stage_ids" class="col-lg-5 o_light_label"/>
                                    <field name="picking_stage_ids" widget="many2many_tags"
                                           domain="[('id', 'in', type_ids)]"
                                           options="{'no_create': True}"
                                           placeholder="Any stage"/>
                                </div>
                            </div>
                        </setting>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
